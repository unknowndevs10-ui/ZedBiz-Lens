# Copy to .env (or .env.local) and adjust.
# true  = run entirely on local mock data (default, no backend needed)
# false = call the FastAPI backend at VITE_API_BASE_URL
VITE_USE_MOCK_DATA=true
VITE_API_BASE_URL=http://localhost:8000
# Optional. Leave blank to use the synthetic English intent model in the browser.
VITE_AGENT_API_URL=
# Supabase browser client (publishable key only; never put a secret/service-role key here)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Optional hosted receipt reading (server-side secrets only; never use VITE_ prefix).
# Add both secrets to Vercel Project Settings > Environment Variables.
VERYFI_CLIENT_ID=
VERYFI_API_KEY=
